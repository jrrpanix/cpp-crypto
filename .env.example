# Environment Configuration for cpp-crypto
# Copy this file to .env and customize for your local setup

# Data directory path - MUST be absolute path for Docker volume mounts
# The data directory has been moved OUTSIDE the project to /Users/yourname/github/data
# This prevents it from being part of the git repository
# 
# Default: ../data (will fail if data is not there)
# Recommended: /Users/yourname/github/data (or wherever you store your data)
DATA_DIR=/Users/yourname/github/data

# Flask environment
FLASK_ENV=development

# Optional: Override specific data paths
# KLINE_DATA_DIR=${DATA_DIR}/klines
# AGGREGATE_DATA_DIR=${DATA_DIR}/kline_aggregate
# DOWNLOAD_DIR=${DATA_DIR}/downloads
