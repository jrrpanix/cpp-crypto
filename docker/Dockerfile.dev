# This is the primary development Dockerfile for the cpp-crypto project.
# It includes all necessary tools for both C++ and Python development.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Step 1: Core build tools and C++ environment
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    time \
    git \
    curl \
    wget \
    gperf \
    pkg-config \
    libssl-dev \
    zlib1g-dev \
    libzmq3-dev \
    libspdlog-dev \
    libcurl4-openssl-dev \
    ca-certificates \
    gnupg \
    lsb-release \
    emacs-nox \
    clang-format \
    clang-tidy \
    vim \
    software-properties-common && \
    rm -rf /var/lib/apt/lists/*

# Step 2: Add Apache Arrow repository and install Arrow/Parquet dev libraries
RUN wget -O apache-arrow-apt-source-latest.deb https://apache.jfrog.io/artifactory/arrow/$(lsb_release --id --short | tr 'A-Z' 'a-z')/apache-arrow-apt-source-latest-$(lsb_release --codename --short).deb && \
    apt-get install -y ./apache-arrow-apt-source-latest.deb && \
    apt-get update && \
    apt-get install -y --no-install-recommends libarrow-dev libparquet-dev && \
    rm ./apache-arrow-apt-source-latest.deb && \
    rm -rf /var/lib/apt/lists/*

# Step 3: Add deadsnakes PPA and install Python 3.12
RUN add-apt-repository ppa:deadsnakes/ppa -y && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-dev \
    python3.12-venv && \
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12 && \
    ln -sf /usr/bin/python3.12 /usr/bin/python && \
    ln -sf /usr/local/bin/pip3 /usr/bin/pip && \
    rm -rf /var/lib/apt/lists/*

# Step 4: Install uv (fast virtualenv + package manager)
RUN curl -Ls https://astral.sh/uv/install.sh | sh
# uv installs to ~/.local/bin by default; add it to PATH
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /workspace

# Copy Python dependency definitions
COPY pyproject.toml uv.lock* /workspace/

# Create/activate venv and resolve deps
ENV VIRTUAL_ENV=/workspace/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
RUN uv sync --no-dev --frozen || uv sync --no-dev

CMD ["/bin/bash"]
